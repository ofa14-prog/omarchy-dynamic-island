#!/usr/bin/env python3
"""Install or remove the Dynamic Island hooks in ~/.claude/settings.json.

  dynamic-island-claude-setup            install (idempotent, backs up first)
  dynamic-island-claude-setup --remove   remove only the island's hooks
"""

import json
import os
import shutil
import sys
import time

HOOK = os.path.join(os.path.dirname(os.path.realpath(__file__)), "dynamic-island-hook")
CONFIG_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
SETTINGS = os.path.join(CONFIG_DIR, "settings.json")

# Events that only report state run async so they never slow Claude down.
ASYNC_EVENTS = ["SessionStart", "SessionEnd", "UserPromptSubmit", "PreToolUse",
                "PostToolUse", "Notification", "Stop", "PreCompact"]
TOOL_EVENTS = {"PreToolUse", "PostToolUse", "PermissionRequest"}


def is_ours(entry):
    return any(HOOK in str(h.get("command", "")) or "dynamic-island-hook" in str(h.get("command", ""))
               for h in entry.get("hooks", []))


def strip(settings):
    hooks = settings.get("hooks") or {}
    for event in list(hooks):
        hooks[event] = [e for e in hooks[event] if not is_ours(e)]
        if not hooks[event]:
            del hooks[event]
    if hooks:
        settings["hooks"] = hooks
    else:
        settings.pop("hooks", None)


def main():
    remove = "--remove" in sys.argv
    settings = {}
    if os.path.exists(SETTINGS):
        with open(SETTINGS) as f:
            settings = json.load(f)
        shutil.copy2(SETTINGS, f"{SETTINGS}.bak.dynamic-island.{int(time.time())}")

    strip(settings)
    if not remove:
        hooks = settings.setdefault("hooks", {})
        for event in ASYNC_EVENTS:
            entry = {"hooks": [{"type": "command", "command": HOOK, "async": True, "timeout": 5}]}
            if event in TOOL_EVENTS:
                entry["matcher"] = "*"
            hooks.setdefault(event, []).append(entry)
        # A day-long timeout: the hook waits for your answer on the island while
        # Claude's own terminal dialog stays live in parallel.
        hooks.setdefault("PermissionRequest", []).append(
            {"matcher": "*", "hooks": [{"type": "command", "command": HOOK, "timeout": 86400}]})

    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = SETTINGS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, SETTINGS)
    print(("Removed Dynamic Island hooks from " if remove else "Installed Dynamic Island hooks in ") + SETTINGS)


if __name__ == "__main__":
    main()
