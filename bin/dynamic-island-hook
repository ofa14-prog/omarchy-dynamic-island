#!/usr/bin/env python3
"""Coding agent -> Dynamic Island bridge.

    dynamic-island-hook [--agent claude|codex|gemini]

Registered as a lifecycle hook by bin/dynamic-island-agent-setup. Claude Code
and Codex share one hook protocol; Gemini CLI's events are mapped onto it.
Ordinary events are one JSON line on the island's unix socket. A
PermissionRequest (Claude Code, Codex) blocks on the socket until the island
answers; the agent races this hook against its own terminal prompt, so
answering in either place wins and the other side is cancelled.

When the island is not running the hook prints nothing and exits 0, so the
agent behaves exactly as if the hook did not exist.
"""

import json
import os
import socket
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
SOCK = os.path.join(RUNTIME, "dynamic-island", "agents.sock")

# Gemini CLI event names -> the shared vocabulary.
GEMINI_EVENTS = {
    "SessionStart": "SessionStart",
    "SessionEnd": "SessionEnd",
    "BeforeAgent": "UserPromptSubmit",
    "AfterAgent": "Stop",
    "BeforeTool": "PreToolUse",
    "AfterTool": "PostToolUse",
    "PreCompress": "PreCompact",
    "Notification": "Notification",
}

SHELLS = {"sh", "bash", "dash", "zsh", "fish", "env", "timeout", "python3", "python"}


def short(value, limit=400):
    text = str(value or "").strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def rel(path, cwd):
    if not path:
        return ""
    try:
        r = os.path.relpath(path, cwd)
        return path if r.startswith("../..") else r
    except ValueError:
        return path


def diff_preview(old, new, limit=6):
    old_lines = str(old or "").splitlines()
    new_lines = str(new or "").splitlines()
    out = [f"- {l}" for l in old_lines[:limit]]
    if len(old_lines) > limit:
        out.append(f"- … (+{len(old_lines) - limit})")
    out += [f"+ {l}" for l in new_lines[:limit]]
    if len(new_lines) > limit:
        out.append(f"+ … (+{len(new_lines) - limit})")
    return "\n".join(out)


def describe_tool(name, tool_input, cwd):
    """(title, detail) pair the island can show without knowing every tool."""
    ti = tool_input if isinstance(tool_input, dict) else {}
    path = ti.get("file_path") or ti.get("absolute_path") or ti.get("path") or ti.get("notebook_path")
    if name in ("Bash", "run_shell_command", "shell", "exec_command"):
        cmd = ti.get("command") or ti.get("cmd")
        if isinstance(cmd, list):
            cmd = " ".join(str(c) for c in cmd)
        return short(ti.get("description") or "Command", 80), short(cmd, 600)
    if name in ("Edit", "replace"):
        return rel(path, cwd), short(diff_preview(ti.get("old_string"), ti.get("new_string")), 700)
    if name == "MultiEdit":
        return rel(path, cwd), f"{len(ti.get('edits') or [])} edits"
    if name in ("Write", "write_file"):
        content = str(ti.get("content") or "")
        return rel(path, cwd), short("\n".join(content.splitlines()[:8]), 600)
    if name == "apply_patch":
        patch = str(ti.get("input") or ti.get("patch") or "")
        files = [l.split(":", 1)[1].strip() for l in patch.splitlines() if l.startswith("*** ") and ":" in l]
        return short(", ".join(files) or "patch", 120), short("\n".join(patch.splitlines()[:10]), 700)
    if name == "NotebookEdit":
        return rel(path, cwd), short(ti.get("new_source"), 400)
    if name in ("Read", "read_file", "read_many_files"):
        return rel(path, cwd), ""
    if name in ("Glob", "Grep", "glob", "search_file_content"):
        return short(ti.get("pattern"), 120), rel(ti.get("path"), cwd)
    if name in ("WebFetch", "web_fetch"):
        return short(ti.get("url") or ti.get("prompt"), 160), short(ti.get("prompt"), 200)
    if name in ("WebSearch", "google_web_search", "web_search"):
        return short(ti.get("query"), 160), ""
    if name in ("Task", "Agent"):
        return short(ti.get("description") or ti.get("subagent_type"), 120), short(ti.get("prompt"), 300)
    if name.startswith("mcp__"):
        parts = name.split("__")
        server = parts[1] if len(parts) > 1 else "mcp"
        tool = parts[2] if len(parts) > 2 else ""
        return f"{server} · {tool}", short(json.dumps(ti, ensure_ascii=False), 400)
    first = ""
    for key in ("file_path", "path", "command", "url", "query", "description"):
        if ti.get(key):
            first = short(ti.get(key), 160)
            break
    return first, short(json.dumps(ti, ensure_ascii=False), 400) if ti else ""


def ancestor_pids(limit=16):
    """PID chain from this hook up to init, so the island can find the
    terminal window that hosts the session and know when it has exited.
    The agent is the first ancestor that is not a shell wrapper."""
    pids, pid = [], os.getppid()
    agent_pid = 0
    while pid > 1 and len(pids) < limit:
        pids.append(pid)
        try:
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            if not agent_pid and comm not in SHELLS:
                agent_pid = pid
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
            pid = int(stat[stat.rindex(")") + 2 :].split()[1])
        except (OSError, ValueError):
            break
    return pids, agent_pid


def build_message(agent, data):
    event = data.get("hook_event_name", "")
    if agent == "gemini":
        event = GEMINI_EVENTS.get(event, event)
    cwd = data.get("cwd") or os.getcwd()
    pids, agent_pid = ancestor_pids()
    msg = {
        "agent": agent,
        "event": event,
        "session": data.get("session_id", ""),
        "cwd": cwd,
        "project": os.path.basename(cwd.rstrip("/")) or cwd,
        "mode": data.get("permission_mode", ""),
        "pids": pids,
        "agentPid": agent_pid,
        "ts": time.time_ns() // 1000,
        # Claude Code: "cli" when interactive, sdk-* for `claude -p` and other
        # headless runs, which the island keeps quiet about.
        "entry": os.environ.get("CLAUDE_CODE_ENTRYPOINT", "") if agent == "claude" else "",
    }
    tool = data.get("tool_name")
    if tool:
        title, detail = describe_tool(tool, data.get("tool_input"), cwd)
        msg.update({"tool": tool, "title": title, "detail": detail})
    if event == "UserPromptSubmit":
        msg["prompt"] = short(data.get("prompt"), 240)
    if event == "Notification":
        msg["message"] = short(data.get("message"), 240)
        msg["kind"] = data.get("notification_type", "")
        # Gemini CLI announces its tool confirmations here but cannot take an
        # answer from a hook: show it as a permission notice.
        if agent == "gemini" and msg["kind"] == "ToolPermission":
            msg["event"] = "PermissionNotice"
            details = data.get("details") if isinstance(data.get("details"), dict) else {}
            msg["tool"] = details.get("tool_name") or details.get("toolName") or details.get("type") or ""
            msg["title"] = short(details.get("title") or details.get("command") or data.get("message"), 160)
    if event == "SessionStart":
        msg["source"] = data.get("source", "")
    if event == "PermissionRequest":
        suggestions = data.get("permission_suggestions")
        # Codex has no "always" answer for hooks yet.
        msg["canAlways"] = agent == "claude" and isinstance(suggestions, list) and len(suggestions) > 0
    return msg


def main():
    agent = "claude"
    if "--agent" in sys.argv:
        i = sys.argv.index("--agent")
        if i + 1 < len(sys.argv):
            agent = sys.argv[i + 1]

    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    # Gemini CLI reads stdout as JSON; an empty object means "no opinion".
    quiet = "{}" if agent == "gemini" else ""

    def done():
        if quiet:
            print(quiet)
        return 0

    if not os.path.exists(SOCK):
        return done()

    msg = build_message(agent, data)
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(0.5)
        sock.connect(SOCK)
    except OSError:
        return done()

    if msg["event"] != "PermissionRequest":
        # Wait for the island's "ok" so the line is read before we hang up;
        # closing straight after sending can drop it on the island side.
        try:
            sock.sendall((json.dumps(msg, ensure_ascii=False) + "\n").encode())
            sock.settimeout(1.0)
            sock.recv(16)
        except OSError:
            pass
        finally:
            sock.close()
        return done()

    # Blocking request: wait for the island's verdict line.
    msg["request"] = f"{agent}-{os.getpid()}-{msg['session'][:8]}"
    try:
        sock.sendall((json.dumps(msg, ensure_ascii=False) + "\n").encode())
        sock.settimeout(None)
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                return 0  # island went away: fall back to the terminal prompt
            buf += chunk
        reply = json.loads(buf.split(b"\n", 1)[0].decode() or "{}")
    except (OSError, ValueError):
        return 0
    finally:
        sock.close()

    verdict = reply.get("behavior")
    if verdict in ("allow", "always"):
        decision = {"behavior": "allow"}
        if verdict == "always" and agent == "claude" and isinstance(data.get("permission_suggestions"), list):
            decision["updatedPermissions"] = data["permission_suggestions"]
    elif verdict == "deny":
        decision = {"behavior": "deny"}
        # Codex rejects extra fields on PermissionRequest decisions.
        if agent == "claude":
            decision["message"] = reply.get("message") or "The user denied this from the Dynamic Island."
    else:
        return 0  # "pass": let the terminal prompt decide

    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
